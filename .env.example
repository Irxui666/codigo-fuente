# COPIAR A VARIABLES DE ENTORNO EN WINDOWS. NO GUARDAR .env EN GIT.
# Servicio y puerto de la conexión KARELY_BD2 en DBeaver.
DB_URL=jdbc:oracle:thin:@//localhost:1522/FREEPDB1
DB_USERNAME=KARELY_BD2
DB_PASSWORD=REEMPLAZAR_SIN_GUARDAR_EN_REPOSITORIO
APP_JWT_SECRET=REEMPLAZAR_CON_CADENA_ALEATORIA_DE_32_O_MAS_CARACTERES
